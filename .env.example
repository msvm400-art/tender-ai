# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma integration.
DATABASE_URL=

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens.
JWT_SECRET=

# SCRAPER_INTERNAL_KEY: Security key used for the internal scraper data ingestion endpoint.
SCRAPER_INTERNAL_KEY=

# PAYMENT GATEWAYS: Optional credentials to support real premium invoicing and gateway checkout dispatches via Razorpay.
# If omitted, system defaults to secure state checkout simulation sandbox seamlessly.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# FIREBASE APP CHECK: reCAPTCHA v3 site key for client check protection
VITE_RECAPTCHA_SITE_KEY=
